{
  "name": "mythra-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "vitest run tests/stress",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run tests/accessibility",
    "test:security": "vitest run tests/unit/operations-security.test.ts tests/accessibility/admin-operations-accessibility.test.tsx",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:dev": "prisma dev --name mythra-v2 --detach",
    "db:verify:foundation": "tsx scripts/verify-foundation-db.ts verify",
    "db:rollback:foundation": "tsx scripts/verify-foundation-db.ts rollback",
    "db:verify:editor": "tsx scripts/verify-editor-core-db.ts verify",
    "db:rollback:editor": "tsx scripts/verify-editor-core-db.ts rollback",
    "db:verify:durability": "tsx scripts/verify-durability-db.ts verify",
    "db:rollback:durability": "tsx scripts/verify-durability-db.ts rollback",
    "db:verify:continuation": "tsx scripts/verify-continuation-db.ts verify",
    "db:rollback:continuation": "tsx scripts/verify-continuation-db.ts rollback",
    "db:verify:structure": "tsx scripts/verify-structure-core-db.ts verify",
    "db:rollback:structure": "tsx scripts/verify-structure-core-db.ts rollback",
    "db:verify:milestones": "tsx scripts/verify-milestones-db.ts verify",
    "db:rollback:milestones": "tsx scripts/verify-milestones-db.ts rollback",
    "db:verify:causality": "tsx scripts/verify-causality-db.ts verify",
    "db:rollback:causality": "tsx scripts/verify-causality-db.ts rollback",
    "db:verify:context": "tsx scripts/verify-context-db.ts verify",
    "db:rollback:context": "tsx scripts/verify-context-db.ts rollback",
    "db:verify:capture": "tsx scripts/verify-capture-db.ts verify",
    "db:rollback:capture": "tsx scripts/verify-capture-db.ts rollback",
    "db:verify:universe": "tsx scripts/verify-universe-db.ts verify",
    "db:rollback:universe": "tsx scripts/verify-universe-db.ts rollback",
    "db:verify:search-language": "tsx scripts/verify-search-language-db.ts verify",
    "db:rollback:search-language": "tsx scripts/verify-search-language-db.ts rollback",
    "db:verify:timeline-research": "tsx scripts/verify-timeline-research-db.ts verify",
    "db:rollback:timeline-research": "tsx scripts/verify-timeline-research-db.ts rollback",
    "db:verify:live-model": "tsx scripts/verify-live-story-model-db.ts verify",
    "db:rollback:live-model": "tsx scripts/verify-live-story-model-db.ts rollback",
    "worker:live-model": "tsx scripts/process-live-model-outbox.ts --drain",
    "repair:live-model": "tsx scripts/rebuild-live-story-model.ts",
    "worker:snapshots": "tsx scripts/process-scheduled-snapshots.ts",
    "worker:alerts": "tsx scripts/process-operational-alerts.ts",
    "db:verify:portability": "tsx scripts/verify-portability-db.ts verify",
    "db:rollback:portability": "tsx scripts/verify-portability-db.ts rollback",
    "db:verify:billing": "tsx scripts/verify-billing-db.ts verify",
    "db:rollback:billing": "tsx scripts/verify-billing-db.ts rollback",
    "test:stress:billing-db": "tsx scripts/stress-billing-db.ts",
    "db:verify:operations": "tsx scripts/verify-launch-operations-db.ts verify",
    "db:rollback:operations": "tsx scripts/verify-launch-operations-db.ts rollback",
    "db:verify:alerts": "tsx scripts/verify-s18-operational-alerts-db.ts verify",
    "db:rollback:alerts": "tsx scripts/verify-s18-operational-alerts-db.ts rollback",
    "db:verify:agent-seam": "tsx scripts/verify-agent-tool-seam-db.ts verify",
    "db:rollback:agent-seam": "tsx scripts/verify-agent-tool-seam-db.ts rollback",
    "drill:backup-restore": "tsx scripts/drill-backup-restore.ts",
    "drill:release": "tsx scripts/verify-release-readiness.ts",
    "audit:launch": "tsx scripts/verify-final-launch-audit.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-bubble-menu": "3.30.5",
    "@tiptap/extension-document": "3.30.5",
    "@tiptap/extension-floating-menu": "3.30.5",
    "@tiptap/extension-paragraph": "3.30.5",
    "@tiptap/extension-text": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "jose": "6.1.0",
    "mammoth": "1.11.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wordpos": "2.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@prisma/dev": "0.25.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "jszip": "^3.10.1",
    "prisma": "7.9.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3",
    "fast-uri": "3.1.7"
  }
}
