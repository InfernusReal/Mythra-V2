{
  "name": "mythra-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "vitest run tests/stress",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run tests/accessibility",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:dev": "prisma dev --name mythra-v2 --detach",
    "db:verify:foundation": "tsx scripts/verify-foundation-db.ts verify",
    "db:rollback:foundation": "tsx scripts/verify-foundation-db.ts rollback",
    "db:verify:editor": "tsx scripts/verify-editor-core-db.ts verify",
    "db:rollback:editor": "tsx scripts/verify-editor-core-db.ts rollback",
    "db:verify:durability": "tsx scripts/verify-durability-db.ts verify",
    "db:rollback:durability": "tsx scripts/verify-durability-db.ts rollback",
    "db:verify:continuation": "tsx scripts/verify-continuation-db.ts verify",
    "db:rollback:continuation": "tsx scripts/verify-continuation-db.ts rollback",
    "db:verify:structure": "tsx scripts/verify-structure-core-db.ts verify",
    "db:rollback:structure": "tsx scripts/verify-structure-core-db.ts rollback",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tiptap/core": "3.30.0",
    "@tiptap/extension-document": "3.30.0",
    "@tiptap/extension-paragraph": "3.30.0",
    "@tiptap/extension-text": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "jose": "6.1.0",
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@prisma/dev": "0.25.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prisma": "7.9.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
