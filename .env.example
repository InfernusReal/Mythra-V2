DATABASE_URL="postgresql://mythra:mythra@127.0.0.1:5432/mythra?sslmode=disable"
AUTH_MODE="development"
AUTH_ISSUER="https://identity.example.com"
AUTH_AUDIENCE="mythra-v2"
AUTH_JWKS_URL="https://identity.example.com/.well-known/jwks.json"
SESSION_SECRET="replace-with-at-least-32-random-characters"
DEV_AUTH_SUBJECT="local-author"
DEV_AUTH_EMAIL="author@example.test"
DEV_AUTH_NAME="Local Author"
APP_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"
