DATABASE_URL="postgresql://mythra:mythra@127.0.0.1:5432/mythra?sslmode=disable"
MYTHRA_ENV="local"
RELEASE_VERSION="development"
WORKER_SCHEMA_VERSION="1"
AUTH_MODE="development"
AUTH_ISSUER="https://identity.example.com"
AUTH_AUDIENCE="mythra-v2"
AUTH_JWKS_URL="https://identity.example.com/.well-known/jwks.json"
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_KEY_ID="v1"
SESSION_PREVIOUS_SECRET="replace-only-during-a-rotation-with-an-independent-secret"
SESSION_PREVIOUS_KEY_ID="v0"
ADMIN_RECOVERY_SECRET="replace-with-an-independent-admin-recovery-secret"
FEATURE_ADMIN_RECOVERY="false"
FEATURE_OPERATIONAL_ANALYTICS="true"
CANARY_EDITOR_SAVE_PERCENT="0"
DEV_AUTH_SUBJECT="local-author"
DEV_AUTH_EMAIL="author@example.test"
DEV_AUTH_NAME="Local Author"
APP_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"
MYTHRA_PRIVATE_STORAGE_ROOT="C:/private/mythra"
MYTHRA_SCANNER_URL="https://scanner.internal.example.com/scan"
BILLING_PROVIDER="fixture"
BILLING_PROVIDER_API_URL="https://billing.internal.example.com"
BILLING_PROVIDER_SECRET="replace-with-provider-secret-at-least-32-characters"
BILLING_WEBHOOK_SECRET="replace-with-webhook-secret-at-least-32-characters"
BILLING_CORE_PRICE_REF="core-usd-monthly-v1"
BILLING_INTELLIGENCE_PRICE_REF="future-intelligence-usd-monthly-v1"
BILLING_CORE_AMOUNT_USD_CENTS="1500"
BILLING_INTELLIGENCE_AMOUNT_USD_CENTS="2500"
