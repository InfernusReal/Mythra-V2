model BillingCustomer {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @unique @db.Uuid
  provider           BillingProvider
  providerCustomerId String          @db.VarChar(160)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([provider, providerCustomerId])
}

model BillingSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @unique @db.Uuid
  provider               BillingProvider
  providerSubscriptionId String             @db.VarChar(160)
  planKey                BillingPlanKey
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart     DateTime?           @db.Timestamptz(3)
  currentPeriodEnd       DateTime?           @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  graceEndsAt            DateTime?           @db.Timestamptz(3)
  providerVersion        BigInt              @default(0)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubscriptionId])
  @@index([status, currentPeriodEnd])
}

model BillingWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String?              @db.Uuid
  provider        BillingProvider
  providerEventId String               @db.VarChar(160)
  eventType       String               @db.VarChar(120)
  payloadSha256   String               @db.Char(64)
  providerVersion BigInt               @default(0)
  status          BillingWebhookStatus @default(RECEIVED)
  errorCode       String?              @db.VarChar(80)
  receivedAt      DateTime             @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?            @db.Timestamptz(3)
  workspace       Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([workspaceId, receivedAt(sort: Desc)])
  @@index([status, receivedAt])
}

model UsageEvent {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @db.Uuid
  resource       UsageResource
  quantity       BigInt
  idempotencyKey String        @db.VarChar(128)
  sourceType     String        @db.VarChar(80)
  sourceId       String?       @db.VarChar(128)
  occurredAt     DateTime      @default(now()) @db.Timestamptz(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, resource, idempotencyKey])
  @@index([workspaceId, resource, occurredAt])
}

model OutboxEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  workspaceId    String                  @db.Uuid
  aggregateType  String                  @db.VarChar(80)
  aggregateId    String                  @db.VarChar(128)
  eventType      String                  @db.VarChar(120)
  payload        Json
  status         OutboxStatus            @default(PENDING)
  attempts       Int                     @default(0)
  schemaVersion  Int                     @default(1)
  availableAt    DateTime                @default(now()) @db.Timestamptz(3)
  leaseOwner     String?                 @db.VarChar(128)
  leasedUntil    DateTime?               @db.Timestamptz(3)
  lastErrorCode  String?                 @db.VarChar(80)
  lastErrorAt    DateTime?               @db.Timestamptz(3)
  deadLetteredAt DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?               @db.Timestamptz(3)
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  delivery       LiveModelEventDelivery?

  @@index([status, availableAt, leasedUntil])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model LiveModelEventDelivery {
  id                       String      @id @default(uuid()) @db.Uuid
  eventId                  String      @unique @db.Uuid
  projectId                String      @db.Uuid
  handlerKey               String      @db.VarChar(120)
  eventSchemaVersion       Int
  projectStructuralVersion Int
  outputDigest             String      @db.VarChar(64)
  processedAt              DateTime    @default(now()) @db.Timestamptz(3)
  event                    OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  project                  Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, projectStructuralVersion, processedAt(sort: Desc)])
}

model LiveModelProjection {
  id                       String                  @id @default(uuid()) @db.Uuid
  projectId                String                  @db.Uuid
  kind                     LiveModelProjectionKind
  scopeType                String                  @db.VarChar(80)
  scopeId                  String                  @db.VarChar(128)
  projectStructuralVersion Int
  sourceObjectVersions     Json                    @default("{}")
  payload                  Json
  digest                   String                  @db.VarChar(64)
  freshness                ProjectionFreshness     @default(FRESH)
  generatedAt              DateTime                @default(now()) @db.Timestamptz(3)
  invalidatedAt            DateTime?               @db.Timestamptz(3)
  lastEventId              String?                 @db.Uuid
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  project                  Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, scopeType, scopeId])
  @@index([projectId, freshness, projectStructuralVersion])
  @@index([projectId, kind, generatedAt(sort: Desc)])
}

model LiveModelWarning {
  id                       String               @id @default(uuid()) @db.Uuid
  projectId                String               @db.Uuid
  warningKey               String               @db.VarChar(320)
  warningType              LiveModelWarningType
  sourceType               String               @db.VarChar(80)
  sourceId                 String               @db.VarChar(128)
  relatedType              String?              @db.VarChar(80)
  relatedId                String?              @db.VarChar(128)
  facts                    Json                 @default("{}")
  projectStructuralVersion Int
  suppressedAt             DateTime?            @db.Timestamptz(3)
  suppressedById           String?              @db.Uuid
  resolvedAt               DateTime?            @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  project                  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, warningKey])
  @@index([projectId, warningType, resolvedAt, suppressedAt])
  @@index([projectId, projectStructuralVersion])
}
