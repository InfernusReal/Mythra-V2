generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditEventKind {
  AUTHENTICATION
  OWNERSHIP_CHANGE
  ARCHIVE
  DELETE_REQUEST
  RESTORE
  EXPORT_REQUEST
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETION_PENDING
}

enum ChapterStatus {
  DRAFT
  REVISED
  FINAL
  ARCHIVED
}

enum ChapterRevisionKind {
  CHECKPOINT
  CONFLICT_SERVER
}

enum DraftConflictStatus {
  OPEN
  RESOLVED
}

enum DraftConflictResolution {
  KEEP_LOCAL
  KEEP_SERVER
  DUPLICATE_RECOVERY
}

enum StructurePresentationMode {
  DISCOVERY
  GUIDED
  ARCHITECT
}

enum StructureLens {
  OUTLINE
  VOLUMES
  CHAPTERS
  RELATIONSHIPS
  SEMANTIC_ZOOM
}

enum NarrativeIntentTargetType {
  PLOT
  VOLUME
  CHAPTER
  SCENE
  PARAGRAPH_SELECTION
}

enum NarrativeIntentCategory {
  TENSION
  REVELATION
  EMOTION
  PACING
  AMBIGUITY
  ATMOSPHERE
  CUSTOM
}

enum StoryReferenceEndpointType {
  PLOT
  PLOT_OUTLINE
  VOLUME
  VOLUME_OUTLINE
  CHAPTER_OUTLINE
  CHAPTER
  SCENE
  NARRATIVE_INTENT
  MANUSCRIPT_BLOCK
  MILESTONE
  ENTITY
  TIMELINE_EVENT
  NOTE
  CAPTURE
}

enum StructureObjectType {
  PLOT
  PLOT_OUTLINE
  VOLUME
  VOLUME_OUTLINE
  CHAPTER_OUTLINE
  CHAPTER
  SCENE
  NARRATIVE_INTENT
  STORY_REFERENCE
}

enum StructureProvenanceType {
  DIRECT
  CHAPTER_PROSE
  OUTLINE_BLOCK
  NOTE
  CAPTURE
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique @db.VarChar(320)
  displayName        String?            @db.VarChar(160)
  locale             String             @default("en") @db.VarChar(35)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  deletionRequestedAt DateTime?          @db.Timestamptz(3)
  purgeAfter         DateTime?          @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)
  externalIdentities ExternalIdentity[]
  memberships        WorkspaceMember[]
  preferences        UserPreference[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  ownedWorkspaces    Workspace[]         @relation("WorkspaceOwner")
  writingSessions    WritingSessionState[]
  structureViewStates StructureViewState[]

  @@index([deletionRequestedAt, purgeAfter])
}

model ExternalIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(64)
  providerSubject String   @db.VarChar(255)
  userId          String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  ownerUserId String            @db.Uuid
  name        String            @db.VarChar(160)
  planKey     String            @default("core") @db.VarChar(64)
  regionKey   String?           @db.VarChar(64)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?         @db.Timestamptz(3)
  purgeAfter  DateTime?         @db.Timestamptz(3)
  members     WorkspaceMember[]
  preferences UserPreference[]
  auditEvents AuditEvent[]
  outboxEvents OutboxEvent[]
  projects     Project[]
  writingSessions WritingSessionState[]
  owner        User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([archivedAt, purgeAfter])
  @@index([ownerUserId])
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  title             String        @db.VarChar(240)
  description       String?
  status            ProjectStatus @default(ACTIVE)
  structuralVersion Int           @default(1)
  activeChapterId   String?       @unique @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?     @db.Timestamptz(3)
  purgeAfter        DateTime?     @db.Timestamptz(3)
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  chapters          Chapter[]     @relation("ProjectChapters")
  activeChapter     Chapter?      @relation("ActiveChapter", fields: [activeChapterId], references: [id], onDelete: SetNull)
  writingSessions   WritingSessionState[]
  plot               Plot?
  volumes            Volume[]
  plotOutline        PlotOutline?
  volumeOutlines     VolumeOutline[]
  chapterOutlines    ChapterOutline[]
  scenes             Scene[]
  narrativeIntents   NarrativeIntent[]
  storyReferences    StoryReference[]
  objectRevisions    ObjectRevision[]
  structureViewStates StructureViewState[]

  @@index([workspaceId, status, updatedAt(sort: Desc)])
}

model Chapter {
  id                String        @id @default(uuid()) @db.Uuid
  projectId         String        @db.Uuid
  volumeId          String?       @db.Uuid
  volumeSequenceIndex Int?
  sequenceIndex     Int
  displayNumber     String?       @db.VarChar(32)
  title             String        @db.VarChar(240)
  bodyDocument      Json
  bodyText          String        @default("")
  wordCount         Int           @default(0)
  documentSchemaVersion Int       @default(1)
  status            ChapterStatus @default(DRAFT)
  version           Int           @default(1)
  targetWords       Int?
  hardCharacterStop Int?
  hardStopEnabled   Boolean       @default(false)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?     @db.Timestamptz(3)
  project           Project       @relation("ProjectChapters", fields: [projectId], references: [id], onDelete: Restrict)
  volume            Volume?       @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  activeForProject  Project?      @relation("ActiveChapter")
  outline           ChapterOutline?
  scenes            Scene[]
  revisions         ChapterRevision[]
  draftConflicts    DraftConflict[]
  saveReceipts      ChapterSaveReceipt[]
  activeWritingSessions WritingSessionState[] @relation("WritingSessionActiveChapter")

  @@unique([projectId, sequenceIndex])
  @@unique([volumeId, volumeSequenceIndex])
  @@index([projectId, volumeId, volumeSequenceIndex])
  @@index([projectId, status, updatedAt(sort: Desc)])
}

model Plot {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @unique @db.Uuid
  title       String    @db.VarChar(240)
  summary     String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  outline     PlotOutline?
  volumes     Volume[]

  @@index([projectId, archivedAt])
}

model PlotOutline {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @unique @db.Uuid
  plotId      String    @unique @db.Uuid
  document    Json
  plainText   String    @default("")
  purpose     String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plot        Plot      @relation(fields: [plotId], references: [id], onDelete: Restrict)

  @@index([projectId, archivedAt])
}

model Volume {
  id                     String    @id @default(uuid()) @db.Uuid
  projectId              String    @db.Uuid
  plotId                 String    @db.Uuid
  sequenceIndex          Int
  displayNumber          String?   @db.VarChar(32)
  title                  String    @db.VarChar(240)
  summary                String?
  targetWords            Int?
  hardTargetWordsEnabled Boolean   @default(false)
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime? @db.Timestamptz(3)
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plot                   Plot      @relation(fields: [plotId], references: [id], onDelete: Restrict)
  outline                VolumeOutline?
  chapters               Chapter[]
  chapterOutlines        ChapterOutline[]

  @@unique([projectId, sequenceIndex])
  @@index([plotId, sequenceIndex])
  @@index([projectId, archivedAt, sequenceIndex])
}

model VolumeOutline {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  volumeId    String    @unique @db.Uuid
  document    Json
  plainText   String    @default("")
  purpose     String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  volume      Volume    @relation(fields: [volumeId], references: [id], onDelete: Restrict)

  @@index([projectId, archivedAt])
}

model ChapterOutline {
  id                     String    @id @default(uuid()) @db.Uuid
  projectId              String    @db.Uuid
  volumeId               String?   @db.Uuid
  chapterId              String?   @unique @db.Uuid
  sequenceIndex          Int
  title                  String    @db.VarChar(240)
  document               Json
  plainText              String    @default("")
  purpose                String?
  emotionalMovement      String?
  revealedInformation    Json      @default("[]")
  entityReferenceKeys    Json      @default("[]")
  locationReferenceKeys  Json      @default("[]")
  milestoneReferenceKeys Json      @default("[]")
  targetWords            Int?
  hardTargetWordsEnabled Boolean   @default(false)
  sceneStubs             Json      @default("[]")
  isPlaceholder          Boolean   @default(false)
  provenanceType         StructureProvenanceType @default(DIRECT)
  provenanceSourceId     String?   @db.VarChar(128)
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime? @db.Timestamptz(3)
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  volume                 Volume?   @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  chapter                Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scenes                 Scene[]

  @@unique([projectId, sequenceIndex])
  @@index([projectId, volumeId, sequenceIndex])
  @@index([projectId, archivedAt, sequenceIndex])
}

model Scene {
  id                     String    @id @default(uuid()) @db.Uuid
  projectId              String    @db.Uuid
  chapterId              String?   @db.Uuid
  chapterOutlineId       String?   @db.Uuid
  sequenceIndex          Int
  title                  String    @db.VarChar(240)
  outlineDocument        Json
  outlineText            String    @default("")
  purpose                String?
  targetWords            Int?
  hardTargetWordsEnabled Boolean   @default(false)
  provenanceType         StructureProvenanceType @default(DIRECT)
  provenanceSourceId     String?   @db.VarChar(128)
  provenanceBlockId      String?   @db.VarChar(128)
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime? @db.Timestamptz(3)
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  chapter                Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chapterOutline         ChapterOutline? @relation(fields: [chapterOutlineId], references: [id], onDelete: SetNull)

  @@index([projectId, sequenceIndex])
  @@index([chapterId, sequenceIndex])
  @@index([chapterOutlineId, sequenceIndex])
  @@index([projectId, archivedAt, sequenceIndex])
}

model NarrativeIntent {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  targetType      NarrativeIntentTargetType
  targetId        String    @db.Uuid
  blockId         String?   @db.VarChar(128)
  selectionAnchor Int?
  selectionHead   Int?
  category        NarrativeIntentCategory?
  customCategory  String?   @db.VarChar(80)
  intentText      String
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, targetType, targetId, archivedAt])
  @@index([projectId, updatedAt(sort: Desc)])
}

model StoryReference {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  sourceType      StoryReferenceEndpointType
  sourceId        String    @db.Uuid
  sourceBlockId   String?   @db.VarChar(128)
  targetType      StoryReferenceEndpointType
  targetId        String    @db.Uuid
  targetBlockId   String?   @db.VarChar(128)
  relationshipKey String    @default("references") @db.VarChar(80)
  provenanceType  StructureProvenanceType @default(DIRECT)
  provenanceNote  String?
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, sourceType, sourceId, archivedAt])
  @@index([projectId, targetType, targetId, archivedAt])
  @@index([projectId, relationshipKey, archivedAt])
}

model ObjectRevision {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  objectType  StructureObjectType
  objectId    String    @db.Uuid
  version     Int
  snapshot    Json
  reason      String?   @db.VarChar(120)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([objectType, objectId, version])
  @@index([projectId, objectType, objectId, createdAt(sort: Desc)])
}

model StructureViewState {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  projectId       String    @db.Uuid
  mode            StructurePresentationMode @default(DISCOVERY)
  activeLens      StructureLens @default(OUTLINE)
  expandedIds     Json      @default("[]")
  activeAnchorType StoryReferenceEndpointType?
  activeAnchorId  String?   @db.Uuid
  cursorOffset    Int?
  selectionAnchor Int?
  selectionHead   Int?
  scrollTop       Int?
  pinIds          Json      @default("[]")
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, activeLens])
}

model ChapterRevision {
  id           String              @id @default(uuid()) @db.Uuid
  chapterId    String              @db.Uuid
  version      Int
  kind         ChapterRevisionKind
  label        String?             @db.VarChar(240)
  clientSaveId String?             @unique @db.Uuid
  bodyDocument Json
  bodyText     String
  wordCount    Int
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  chapter      Chapter             @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([chapterId, createdAt(sort: Desc)])
  @@index([chapterId, version])
}

model DraftConflict {
  id             String                   @id @default(uuid()) @db.Uuid
  chapterId      String                   @db.Uuid
  clientSaveId   String                   @db.Uuid
  baseVersion    Int
  serverVersion  Int
  localDocument  Json
  serverDocument Json
  status         DraftConflictStatus      @default(OPEN)
  resolution     DraftConflictResolution?
  resolvedVersion Int?
  recoveryChapterId String?                 @db.Uuid
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?                @db.Timestamptz(3)
  chapter        Chapter                  @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@unique([chapterId, clientSaveId])
  @@index([chapterId, status, createdAt(sort: Desc)])
}

model ChapterSaveReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  chapterId        String   @db.Uuid
  clientSaveId     String   @db.Uuid
  bodyHash         String   @db.Char(64)
  baseVersion      Int
  resultingVersion Int
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  chapter          Chapter  @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@unique([chapterId, clientSaveId])
  @@index([chapterId, createdAt(sort: Desc)])
}

model WritingSessionState {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  workspaceId        String   @db.Uuid
  projectId          String   @db.Uuid
  activeChapterId    String?  @db.Uuid
  blockId            String?  @db.VarChar(64)
  cursorOffset       Int?
  selectionAnchor    Int?
  selectionHead      Int?
  scrollTop          Int?
  contextPanelMode   String   @default("CLOSED") @db.VarChar(32)
  pinIds             Json     @default("[]")
  capturedAt         DateTime @default(now()) @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activeChapter      Chapter? @relation("WritingSessionActiveChapter", fields: [activeChapterId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
  @@index([workspaceId, projectId])
  @@index([activeChapterId])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  status      WorkspaceMemberStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, workspaceId])
}

model UserPreference {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  locale      String    @default("en") @db.VarChar(35)
  theme       String    @default("system") @db.VarChar(16)
  editorFont  String    @default("serif") @db.VarChar(64)
  fontSize    Int       @default(18)
  lineHeight  Float     @default(1.62)
  reducedMotion Boolean @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @db.Uuid
  actorUserId   String?        @db.Uuid
  kind          AuditEventKind
  targetType    String         @db.VarChar(80)
  targetId      String?        @db.VarChar(128)
  correlationId String         @db.VarChar(128)
  safeMetadata  Json           @default("{}")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor         User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([correlationId])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  aggregateType String       @db.VarChar(80)
  aggregateId   String       @db.VarChar(128)
  eventType     String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?    @db.Timestamptz(3)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([workspaceId, createdAt(sort: Desc)])
}
