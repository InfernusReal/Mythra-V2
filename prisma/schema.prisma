model OperationalEvent {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  actorUserId    String?  @db.Uuid
  projectId      String?  @db.Uuid
  eventName      String   @db.VarChar(120)
  routeKey       String?  @db.VarChar(120)
  durationMs     Int?
