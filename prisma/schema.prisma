  NOTE
  URL
  EXCERPT
  CITATION
  FILE
}

enum AssetScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED
  ERROR
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique @db.VarChar(320)
  displayName         String?               @db.VarChar(160)
  locale              String                @default("en") @db.VarChar(35)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  deletionRequestedAt DateTime?             @db.Timestamptz(3)
  purgeAfter          DateTime?             @db.Timestamptz(3)
  deletedAt           DateTime?             @db.Timestamptz(3)
  externalIdentities  ExternalIdentity[]
  memberships         WorkspaceMember[]
  preferences         UserPreference[]
  auditEvents         AuditEvent[]          @relation("AuditActor")
  ownedWorkspaces     Workspace[]           @relation("WorkspaceOwner")
  writingSessions     WritingSessionState[]
  structureViewStates StructureViewState[]
  contextPreferences  ContextPreference[]
  contextPins         ContextPin[]
  captures            Capture[]
  captureConversions  CaptureConversion[]
  storyEntities       StoryEntity[]         @relation("StoryEntityCreator")
  entityRevisions     EntityRevision[]      @relation("EntityRevisionActor")
  searchDocuments     SearchDocument[]      @relation("SearchDocumentOwner")
  savedVocabulary     SavedVocabularyTerm[]
  notes               Note[]                @relation("NoteCreator")
  researchItems       ResearchItem[]        @relation("ResearchItemCreator")
  storedAssets        StoredAsset[]         @relation("StoredAssetCreator")
  operationalEvents   OperationalEvent[]    @relation("OperationalEventActor")
  recoveryActions     RecoveryAction[]      @relation("RecoveryActionActor")

  @@index([deletionRequestedAt, purgeAfter])
}

model ExternalIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(64)
  providerSubject String   @db.VarChar(255)
  userId          String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @db.Timestamptz(3)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Workspace {
  id              String                @id @default(uuid()) @db.Uuid
  ownerUserId     String                @db.Uuid
  name            String                @db.VarChar(160)
  planKey         String                @default("core") @db.VarChar(64)
  regionKey       String?               @db.VarChar(64)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?             @db.Timestamptz(3)
  purgeAfter      DateTime?             @db.Timestamptz(3)
  members         WorkspaceMember[]
  preferences     UserPreference[]
  auditEvents     AuditEvent[]
  outboxEvents    OutboxEvent[]
  projects        Project[]
  writingSessions WritingSessionState[]
  searchDocuments SearchDocument[]
  savedVocabulary SavedVocabularyTerm[]
  storedAssets    StoredAsset[]
  billingCustomer BillingCustomer?
  subscription    BillingSubscription?
  billingWebhooks BillingWebhookEvent[]
  usageEvents     UsageEvent[]
  operationalEvents OperationalEvent[]
  recoveryActions RecoveryAction[]
  owner           User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([archivedAt, purgeAfter])
  @@index([ownerUserId])
}

model Project {
  id                    String                   @id @default(uuid()) @db.Uuid
  workspaceId           String                   @db.Uuid
  title                 String                   @db.VarChar(240)
  description           String?
  status                ProjectStatus            @default(ACTIVE)
  structuralVersion     Int                      @default(1)
  activeChapterId       String?                  @unique @db.Uuid
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?                @db.Timestamptz(3)
  purgeAfter            DateTime?                @db.Timestamptz(3)
  workspace             Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  chapters              Chapter[]                @relation("ProjectChapters")
  activeChapter         Chapter?                 @relation("ActiveChapter", fields: [activeChapterId], references: [id], onDelete: SetNull)
  writingSessions       WritingSessionState[]
  plot                  Plot?
  volumes               Volume[]
  plotOutline           PlotOutline?
  volumeOutlines        VolumeOutline[]
  chapterOutlines       ChapterOutline[]
  scenes                Scene[]
  narrativeIntents      NarrativeIntent[]
  storyReferences       StoryReference[]
  objectRevisions       ObjectRevision[]
  structureViewStates   StructureViewState[]
  milestones            Milestone[]
  chapterMilestoneLinks ChapterMilestoneLink[]
  milestoneDependencies MilestoneDependency[]
  storyChanges          StoryChange[]
  causalRelations       CausalRelation[]
  contextPreferences    ContextPreference[]
  contextPins           ContextPin[]
  captures              Capture[]
  captureAttachments    CaptureAttachment[]
  captureConversions    CaptureConversion[]
  captureRevisions      CaptureRevision[]
  entityTypes           EntityType[]
  storyEntities         StoryEntity[]
  relationTypes         RelationType[]
  entityRelations       EntityRelation[]
  entityStateSnapshots  EntityStateSnapshot[]
  entityRevisions       EntityRevision[]
  searchDocuments       SearchDocument[]
  savedVocabulary       SavedVocabularyTerm[]
  timelineEvents        TimelineEvent[]
  timelineEventLinks    TimelineEventLink[]
  notes                 Note[]
  researchItems         ResearchItem[]
  storedAssets          StoredAsset[]
  notePromotions        NotePromotion[]
  researchItemLinks     ResearchItemLink[]
  liveModelProjections  LiveModelProjection[]
  liveModelWarnings     LiveModelWarning[]
  liveModelDeliveries   LiveModelEventDelivery[]
  projectSnapshots      ProjectSnapshot[]
  portabilityArtifacts  PortabilityArtifact[]
  importSessions        ImportSession[]
  operationalEvents     OperationalEvent[]

  @@index([workspaceId, status, updatedAt(sort: Desc)])
}

model Chapter {
  id                    String                 @id @default(uuid()) @db.Uuid
  projectId             String                 @db.Uuid
  volumeId              String?                @db.Uuid
  volumeSequenceIndex   Int?
  sequenceIndex         Int
  displayNumber         String?                @db.VarChar(32)
  title                 String                 @db.VarChar(240)
  bodyDocument          Json
  bodyText              String                 @default("")
  wordCount             Int                    @default(0)
  documentSchemaVersion Int                    @default(1)
  status                ChapterStatus          @default(DRAFT)
  version               Int                    @default(1)
  targetWords           Int?
  hardCharacterStop     Int?
  hardStopEnabled       Boolean                @default(false)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?              @db.Timestamptz(3)
  project               Project                @relation("ProjectChapters", fields: [projectId], references: [id], onDelete: Restrict)
  volume                Volume?                @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  activeForProject      Project?               @relation("ActiveChapter")
  outline               ChapterOutline?
  scenes                Scene[]
  revisions             ChapterRevision[]
  draftConflicts        DraftConflict[]
  saveReceipts          ChapterSaveReceipt[]
  activeWritingSessions WritingSessionState[]  @relation("WritingSessionActiveChapter")
  milestoneLinks        ChapterMilestoneLink[]

  @@unique([projectId, sequenceIndex])
  @@unique([volumeId, volumeSequenceIndex])
  @@index([projectId, volumeId, volumeSequenceIndex])
  @@index([projectId, status, updatedAt(sort: Desc)])
}

model Plot {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @unique @db.Uuid
  title      String       @db.VarChar(240)
  summary    String?
  version    Int          @default(1)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt DateTime?    @db.Timestamptz(3)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  outline    PlotOutline?
  volumes    Volume[]

  @@index([projectId, archivedAt])
}

model PlotOutline {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @unique @db.Uuid
  plotId     String    @unique @db.Uuid
  document   Json
  plainText  String    @default("")
  purpose    String?
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plot       Plot      @relation(fields: [plotId], references: [id], onDelete: Restrict)

  @@index([projectId, archivedAt])
}

model Volume {
  id                     String           @id @default(uuid()) @db.Uuid
  projectId              String           @db.Uuid
  plotId                 String           @db.Uuid
  sequenceIndex          Int
  displayNumber          String?          @db.VarChar(32)
  title                  String           @db.VarChar(240)
  summary                String?
  targetWords            Int?
  hardTargetWordsEnabled Boolean          @default(false)
  version                Int              @default(1)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime?        @db.Timestamptz(3)
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plot                   Plot             @relation(fields: [plotId], references: [id], onDelete: Restrict)
  outline                VolumeOutline?
  chapters               Chapter[]
  chapterOutlines        ChapterOutline[]

  @@unique([projectId, sequenceIndex])
  @@index([plotId, sequenceIndex])
  @@index([projectId, archivedAt, sequenceIndex])
}

model VolumeOutline {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  volumeId   String    @unique @db.Uuid
  document   Json
  plainText  String    @default("")
  purpose    String?
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  volume     Volume    @relation(fields: [volumeId], references: [id], onDelete: Restrict)

  @@index([projectId, archivedAt])
}

model ChapterOutline {
  id                     String                  @id @default(uuid()) @db.Uuid
  projectId              String                  @db.Uuid
  volumeId               String?                 @db.Uuid
  chapterId              String?                 @unique @db.Uuid
  sequenceIndex          Int
  title                  String                  @db.VarChar(240)
  document               Json
  plainText              String                  @default("")
  purpose                String?
  emotionalMovement      String?
  revealedInformation    Json                    @default("[]")
  entityReferenceKeys    Json                    @default("[]")
  locationReferenceKeys  Json                    @default("[]")
  milestoneReferenceKeys Json                    @default("[]")
  targetWords            Int?
  hardTargetWordsEnabled Boolean                 @default(false)
  sceneStubs             Json                    @default("[]")
  isPlaceholder          Boolean                 @default(false)
  provenanceType         StructureProvenanceType @default(DIRECT)
  provenanceSourceId     String?                 @db.VarChar(128)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime?               @db.Timestamptz(3)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  volume                 Volume?                 @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  chapter                Chapter?                @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scenes                 Scene[]

  @@unique([projectId, sequenceIndex])
  @@index([projectId, volumeId, sequenceIndex])
  @@index([projectId, archivedAt, sequenceIndex])
}

model Scene {
  id                     String                  @id @default(uuid()) @db.Uuid
  projectId              String                  @db.Uuid
  chapterId              String?                 @db.Uuid
  chapterOutlineId       String?                 @db.Uuid
  sequenceIndex          Int
  title                  String                  @db.VarChar(240)
  outlineDocument        Json
  outlineText            String                  @default("")
  purpose                String?
  targetWords            Int?
  hardTargetWordsEnabled Boolean                 @default(false)
  provenanceType         StructureProvenanceType @default(DIRECT)
  provenanceSourceId     String?                 @db.VarChar(128)
  provenanceBlockId      String?                 @db.VarChar(128)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime?               @db.Timestamptz(3)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  chapter                Chapter?                @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chapterOutline         ChapterOutline?         @relation(fields: [chapterOutlineId], references: [id], onDelete: SetNull)

  @@index([projectId, sequenceIndex])
  @@index([chapterId, sequenceIndex])
  @@index([chapterOutlineId, sequenceIndex])
  @@index([projectId, archivedAt, sequenceIndex])
}

model NarrativeIntent {
  id              String                    @id @default(uuid()) @db.Uuid
  projectId       String                    @db.Uuid
  targetType      NarrativeIntentTargetType
  targetId        String                    @db.Uuid
  blockId         String?                   @db.VarChar(128)
  selectionAnchor Int?
  selectionHead   Int?
  category        NarrativeIntentCategory?
  customCategory  String?                   @db.VarChar(80)
  intentText      String
  version         Int                       @default(1)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?                 @db.Timestamptz(3)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, targetType, targetId, archivedAt])
  @@index([projectId, updatedAt(sort: Desc)])
}

model StoryReference {
  id              String                     @id @default(uuid()) @db.Uuid
  projectId       String                     @db.Uuid
  sourceType      StoryReferenceEndpointType
  sourceId        String                     @db.Uuid
  sourceBlockId   String?                    @db.VarChar(128)
  targetType      StoryReferenceEndpointType
  targetId        String                     @db.Uuid
  targetBlockId   String?                    @db.VarChar(128)
  relationshipKey String                     @default("references") @db.VarChar(80)
  provenanceType  StructureProvenanceType    @default(DIRECT)
  provenanceNote  String?
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?                  @db.Timestamptz(3)
  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, sourceType, sourceId, archivedAt])
  @@index([projectId, targetType, targetId, archivedAt])
  @@index([projectId, relationshipKey, archivedAt])
}

model ObjectRevision {
  id                    String              @id @default(uuid()) @db.Uuid
  projectId             String              @db.Uuid
  objectType            StructureObjectType
  objectId              String              @db.Uuid
  version               Int
  snapshot              Json
  reason                String?             @db.VarChar(120)
  representationVersion String              @default("2.2.1") @db.VarChar(24)
  snapshotHash          String?             @db.Char(64)
  createdById           String?             @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([objectType, objectId, version])
  @@index([projectId, objectType, objectId, createdAt(sort: Desc)])
}

model ProjectSnapshot {
  id                    String                @id @default(uuid()) @db.Uuid
  projectId             String                @db.Uuid
  createdById           String                @db.Uuid
  status                ProjectSnapshotStatus @default(PENDING)
  representationVersion String                @default("2.2.1") @db.VarChar(24)
  structuralVersion     Int
  storageKey            String?               @unique @db.VarChar(320)
  manifest              Json?
  sha256                String?               @db.Char(64)
  sizeBytes             BigInt?
  idempotencyKey        String                @db.VarChar(96)
  attempts              Int                   @default(0)
  lastErrorCode         String?               @db.VarChar(80)
  requestedAt           DateTime              @default(now()) @db.Timestamptz(3)
  completedAt           DateTime?             @db.Timestamptz(3)
  verifiedAt            DateTime?             @db.Timestamptz(3)
  retentionUntil        DateTime              @db.Timestamptz(3)
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  artifacts             PortabilityArtifact[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, requestedAt(sort: Desc)])
  @@index([status, retentionUntil])
}

model PortabilityArtifact {
  id                    String                     @id @default(uuid()) @db.Uuid
  projectId             String                     @db.Uuid
  snapshotId            String?                    @db.Uuid
  createdById           String                     @db.Uuid
  purpose               PortabilityArtifactPurpose
  scope                 PortabilityArtifactScope
  format                PortabilityArtifactFormat
  status                PortabilityArtifactStatus  @default(PENDING)
  representationVersion String                     @default("2.2.1") @db.VarChar(24)
  sourceObjectId        String?                    @db.Uuid
  storageKey            String?                    @unique @db.VarChar(320)
  manifest              Json?
  sha256                String?                    @db.Char(64)
  sizeBytes             BigInt?
  idempotencyKey        String                     @db.VarChar(96)
  attempts              Int                        @default(0)
  lastErrorCode         String?                    @db.VarChar(80)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  completedAt           DateTime?                  @db.Timestamptz(3)
  verifiedAt            DateTime?                  @db.Timestamptz(3)
